# GRM / eMGP — production environment. Copy to .env next to docker-compose.yaml and fill it.
# Never commit the real .env (it is git-ignored).

# --- Image -------------------------------------------------------------------------------------
GRM_IMAGE=cosobenin/grm-app:v.2.1.1
# Host port nginx listens on (the domain provider forwards HTTPS traffic to it)
HTTP_PORT=80

# --- Django ------------------------------------------------------------------------------------
# Generate with: docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=mgp.coso.gouv.bj
CSRF_TRUSTED_ORIGINS=https://mgp.coso.gouv.bj
# HTTPS is terminated by the domain provider: trust X-Forwarded-Proto and use secure cookies
BEHIND_HTTPS_PROXY=True
LANGUAGE_CODE=fr
TIME_ZONE=Africa/Porto-Novo

# --- Database (PostgreSQL container) -----------------------------------------------------------
POSTGRES_DB=grm
POSTGRES_USER=grm
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://grm:change-me@db:5432/grm

# --- Background jobs (Redis container) ---------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- SMS (not budgeted yet: SMS are only written to the logs) — see docs/notifications.md -------
TWILIO_DEBUG_MODE=True
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
COUNTRY_CALLING_CODE=229

# --- Email (citizen notifications, password reset) ---------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Diagnostics map (Benin defaults) ----------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
DIAGNOSTIC_MAP_LATITUDE=9.3077
DIAGNOSTIC_MAP_LONGITUDE=2.3158
DIAGNOSTIC_MAP_ZOOM=6.5
DIAGNOSTIC_MAP_WS_BOUND=[0.77, 6.14]
DIAGNOSTIC_MAP_EN_BOUND=[3.85, 12.42]
DIAGNOSTIC_MAP_ISO_CODE=BEN

# --- Optional: AI insight and semantic search (features degrade gracefully when empty) ---------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=800
PINECONE_API_KEY=
PINECONE_INDEX_NAME=grm-grievances
HUGGINGFACE_API_KEY=
